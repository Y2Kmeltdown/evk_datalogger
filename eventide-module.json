{
  "name": "evk-datalogger",
  "version": "1.1.0",
  "description": "EVK4 event camera datalogger with HTTP API control (runtime biases, rate limiter, circular buffer) and an MJPEG live-stream server (viewfinder).",
  "author": "Y2Kmeltdown",
  "dependencies": {
    "apt": ["build-essential", "pkg-config", "libusb-1.0-0-dev"],
    "commands": [
      "{venv_dir}/bin/neuromorphic-drivers-install-udev-rules",
      "{venv_python} {venv_dir}/lib/python3.*/site-packages/neuromorphic_drivers/udev.py"
    ]
  },
  "install": {
    "commands": ["cargo build --release"],
    "artifacts": {
      "target/release/evk_datalogger": "{install_dir}/evk_datalogger",
      "target/release/viewfinder": "{install_dir}/viewfinder"
    }
  },
  "recordings_subdir": "evk",
  "arguments": [
    {
      "name": "file_length",
      "flag": "--file-length",
      "type": "int",
      "default": 60,
      "required": false,
      "description": "Seconds before rolling over to a new raw recording file."
    },
    {
      "name": "rate_limit",
      "flag": "--rate-limit",
      "type": "int",
      "default": 0,
      "required": false,
      "description": "Initial hardware event-rate limit (events/second). 0 = unlimited. Adjustable at runtime via the HTTP API."
    },
    {
      "name": "diff_on",
      "flag": "--diff-on",
      "type": "int",
      "default": 102,
      "required": false,
      "description": "Initial diff_on camera bias (ON-event contrast threshold, 0-255). Adjustable at runtime via the HTTP API."
    },
    {
      "name": "diff_off",
      "flag": "--diff-off",
      "type": "int",
      "default": 102,
      "required": false,
      "description": "Initial diff_off camera bias (OFF-event contrast threshold, 0-255). Adjustable at runtime via the HTTP API."
    },
    {
      "name": "buffer_max_age",
      "flag": "--buffer-max-age",
      "type": "int",
      "default": 10,
      "required": false,
      "description": "Circular buffer cap: maximum seconds of raw history retained (0 = buffer off). Adjustable at runtime via the HTTP API."
    },
    {
      "name": "buffer_max_bytes",
      "flag": "--buffer-max-bytes",
      "type": "int",
      "default": 104857600,
      "required": false,
      "description": "Circular buffer cap: maximum bytes of raw history retained (0 = buffer off). Adjustable at runtime via the HTTP API."
    },
    {
      "name": "stream_quality",
      "flag": "--quality",
      "type": "int",
      "default": 15,
      "required": false,
      "description": "JPEG quality for the live stream (1-100)."
    }
  ],
  "sockets": [
    {
      "name": "events",
      "type": "unix",
      "path": "/tmp/evk4_events.sock",
      "description": "Decoded DVS events: published by event_based_camera, consumed by evk_mjpeg_server and the dashboard backend."
    },
    {
      "name": "triggers",
      "type": "unix",
      "path": "/tmp/evk4_triggers.sock",
      "description": "Trigger events published by event_based_camera (see trigger_test.py)."
    },
    {
      "name": "mjpeg",
      "type": "tcp",
      "description": "Viewfinder MJPEG stream plus /api/settings and /api/streaming. Port allocated by eventide at install time; reachable at /proxy/evk-datalogger/mjpeg/."
    },
    {
      "name": "http_api",
      "type": "tcp",
      "description": "Datalogger HTTP API: recording status, runtime camera biases, rate limiter, and circular buffer caps. Port allocated by eventide at install time. Recording itself is always on (built without --record-toggle)."
    }
  ],
  "ui": [
    {
      "id": "live",
      "type": "mjpeg",
      "title": "EVK4 LIVE",
      "region": "center",
      "default": true,
      "socket": "mjpeg",
      "path": "/stream"
    },
    {
      "id": "stream-settings",
      "type": "form",
      "title": "EVK4 STREAM",
      "region": "sidebar",
      "default": true,
      "socket": "mjpeg",
      "get": "/api/settings",
      "put": "/api/settings",
      "fields": [
        {"key": "quality", "label": "Quality", "kind": "slider", "min": 1, "max": 100},
        {"key": "out_width", "label": "Width", "kind": "number", "min": 1},
        {"key": "out_height", "label": "Height", "kind": "number", "min": 1},
        {"key": "streaming", "label": "Stream enabled", "kind": "toggle", "get": "/api/streaming", "put": "/api/streaming"}
      ]
    },
    {
      "id": "biases",
      "type": "form",
      "title": "EVK4 BIASES",
      "region": "sidebar",
      "default": true,
      "socket": "http_api",
      "get": "/api/biases",
      "put": "/api/biases",
      "fields": [
        {"key": "diff_on", "label": "diff_on (0-255)", "kind": "number", "min": 0, "max": 255},
        {"key": "diff_off", "label": "diff_off (0-255)", "kind": "number", "min": 0, "max": 255}
      ]
    },
    {
      "id": "recording",
      "type": "form",
      "title": "EVK4 RECORDING",
      "region": "sidebar",
      "default": true,
      "socket": "http_api",
      "fields": [
        {"key": "events_per_second", "label": "Rate limit (ev/s, 0 = unlimited)", "kind": "number", "min": 0, "get": "/api/rate-limit", "put": "/api/rate-limit"},
        {"key": "max_age_secs", "label": "Buffer max age (s)", "kind": "number", "min": 0, "get": "/api/buffer", "put": "/api/buffer"},
        {"key": "max_bytes", "label": "Buffer max bytes", "kind": "number", "min": 0, "get": "/api/buffer", "put": "/api/buffer"}
      ]
    },
    {
      "id": "rec-status",
      "type": "telemetry",
      "title": "EVK4 RECORDER STATUS",
      "region": "sidebar",
      "default": false,
      "socket": "http_api",
      "get": "/api/status",
      "interval": 3000,
      "rows": [
        {"label": "RECORDING", "path": "recording"},
        {"label": "FILE", "path": "current_file"},
        {"label": "BUFFER BYTES", "path": "buffer.bytes"},
        {"label": "BUFFER CHUNKS", "path": "buffer.chunks"}
      ]
    }
  ],
  "programs": [
    {
      "name": "event_based_camera",
      "command": "{install_dir}/evk_datalogger --output-dir {recordings_subdir} --events-socket {socket:events} --triggers-socket {socket:triggers} --file-length {arg:file_length} --rate-limit {arg:rate_limit} --diff-on {arg:diff_on} --diff-off {arg:diff_off} --api-bind 0.0.0.0:{socket:http_api} --buffer-max-age {arg:buffer_max_age} --buffer-max-bytes {arg:buffer_max_bytes}",
      "directory": "{install_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 1,
      "user": "root"
    },
    {
      "name": "evk_mjpeg_server",
      "command": "{install_dir}/viewfinder --bind 0.0.0.0:{socket:mjpeg} --events-socket {socket:events} --quality {arg:stream_quality}",
      "directory": "{install_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 2,
      "user": "root"
    }
  ]
}
